<com:TContent ID="Content">
	<h1>Active Dialog Test Case</h1>

	<com:TActiveDialog ID="dialog1" OnOpen="dialog_opened" OnClose="dialog_closed">
		<p>Dialog content.</p>
		<button type="button" id="dismissBtn" onclick="this.closest('dialog').close()">Dismiss</button>
	</com:TActiveDialog>

	<p>Status: <com:TActiveLabel ID="label1" Text="waiting" /></p>

	<com:TActiveButton ID="button1" Text="Server Open" OnClick="open_dialog" />
	<com:TActiveButton ID="button2" Text="Server Close" OnClick="close_dialog" />
	<button type="button" id="showBtn" onclick="document.querySelector('dialog').show()">Client Show</button>

	<com:TActiveDialog ID="dialog2" Modal="true" OnClose="confirm_closed" Attributes.aria-labelledby="confirmTitle">
		<h2 id="confirmTitle">Confirm</h2>
		<com:TButton ID="confirmOk" Text="OK" CommandFor="dialog2" Command="close" Attributes.value="ok" />
		<com:TButton ID="confirmCancel" Text="Cancel" CommandFor="dialog2" Command="close" Attributes.value="cancel" />
	</com:TActiveDialog>

	<p>Confirm: <com:TActiveLabel ID="label2" Text="waiting" /></p>
	<com:TButton ID="openConfirm" Text="Confirm" CommandFor="dialog2" Command="show-modal" />
	<com:TActiveButton ID="button3" Text="Server Open Modal" OnClick="open_confirm" />
</com:TContent>
