		Click Me!
	</div>
	<com:TClientScript>
		jQuery( document ).ready(function() {
			jQuery("#div1").click(function() {
				Prado.Callback("<%= $this->callback1->UniqueID %>");
			});
		});
	</com:TClientScript>
</com:TContent>