<com:TContent ID="Content">
<h1>Prado PasswordStrengthValidator Tests</h1>
<div>
	<com:TLabel ForControl="text1" Text="New password" />
	<com:TTextBox ID="text1" TextMode="Password" Attributes.autocomplete="new-password" />
	<com:TPasswordStrengthMeter ID="meter1" ControlToMeasure="text1" ShowBits="true" />
	<com:TPasswordStrengthValidator
		ID="validator1"
		ControlToValidate="text1"
		ErrorMessage="Use a longer password with more kinds of characters"
		ControlCssClass="required" />

	<com:TLabel ForControl="text2" Text="Strong password" />
	<com:TTextBox ID="text2" TextMode="Password" Attributes.autocomplete="new-password" />
	<com:TPasswordStrengthMeter ID="meter2" ControlToMeasure="text2" ShowText="false" ShowBits="true" Culture="de" />
	<com:TPasswordStrengthValidator
		ID="validator2"
		ControlToValidate="text2"
		ErrorMessage="Server: the password is not strong enough"
		MinStrength="Strong"
		EnableClientScript="false" />

	<com:TButton ID="submit1" Text="Test" OnClick="submitted" />
	<com:TLabel ID="status" />
</div>
</com:TContent>
