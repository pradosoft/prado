<com:TContent ID="Content">
	<h1>Proof of Work Test</h1>
	<com:TLabel ForControl="Name" Text="Name" />
	<com:TTextBox ID="Name" />
	<com:TProofOfWork ID="Work" Complexity="20000" />
	<com:TProofOfWorkValidator ID="WorkValidator" ControlToValidate="Work" ErrorMessage="Verification failed." />
	<com:TButton ID="Send" Text="Send" OnClick="sendClicked" />
	<p><com:TLabel ID="Result" /></p>
</com:TContent>
